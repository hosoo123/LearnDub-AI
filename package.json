{
  "name": "learndub-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run typecheck:extension && npm run build:extension",
    "typecheck:extension": "tsc --noEmit -p extension/tsconfig.json",
    "build:extension": "node scripts/build-extension.mjs",
    "package:extension": "npm run build:extension && node scripts/package-extension.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "next": "^16.4.5",
    "node-edge-tts": "^1.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
